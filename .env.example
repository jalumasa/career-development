# Server-side only — read by api/*.js. Never prefix with REACT_APP_
# (that prefix gets the value bundled into the public client JS).
# Set real values in your Vercel project's environment variables for
# production, and in a local .env for `vercel dev`.

# Used by api/chatbot.js (Compass AI)
ANTHROPIC_API_KEY=

# Used by api/refresh-events.js (weekly networking-events refresh).
# FIREBASE_SERVICE_ACCOUNT_KEY is the full contents of a Firebase service
# account key JSON file (Project Settings -> Service Accounts -> Generate
# new private key), pasted as a single-line JSON string.
# EVENTS_REFRESH_SECRET is any random string — sent as the X-Refresh-Secret
# header by the weekly scheduled task so only it can trigger a refresh.
FIREBASE_SERVICE_ACCOUNT_KEY=
EVENTS_REFRESH_SECRET=
